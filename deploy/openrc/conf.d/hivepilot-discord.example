[ -f /etc/hivepilot/shared.env ] && . /etc/hivepilot/shared.env
# ^ vars every hivepilot-* service must share (e.g. IS_SANDBOX) live
# there, not here -- see deploy/openrc/conf.d/shared.env.example and
# deploy/openrc/README.md, "Env silos -- read this".

# Copy to /etc/conf.d/hivepilot-discord and fill in the placeholders.
#
# OpenRC runs this service with cwd=/ -- keep every path-shaped value below
# absolute (see deploy/openrc/README.md, "env-silo warning").
#
# Gateway mode (this service's default -- outbound-only WebSocket, no public
# HTTPS endpoint needed) only needs the bot token below.

export HIVEPILOT_BASE_DIR=/data
export HIVEPILOT_DISCORD_BOT_TOKEN=<your-bot-token>

# HIVEPILOT_DISCORD_PUBLIC_KEY is ONLY used by webhook (HTTP interactions)
# mode's Ed25519 signature verification -- leave it unset for gateway mode.
# export HIVEPILOT_DISCORD_PUBLIC_KEY=<ed25519-public-key-hex>

# Optional: restrict which guilds/channels the bot will respond in / notify
# (JSON arrays of numeric snowflake IDs) -- open to all when unset.
# export HIVEPILOT_DISCORD_ALLOWED_GUILD_IDS=[123456789012345678]
# export HIVEPILOT_DISCORD_ALLOWED_CHANNEL_IDS=[123456789012345678]
# export HIVEPILOT_DISCORD_NOTIFICATION_CHANNEL_ID=123456789012345678
