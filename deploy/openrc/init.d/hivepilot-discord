#!/sbin/openrc-run
description="HivePilot Discord bot (gateway/WebSocket -- outbound only, no public endpoint)"
command="/opt/hivepilot/venv/bin/hivepilot"
command_args="discord start --mode gateway"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/hivepilot-discord.log"
error_log="/var/log/hivepilot-discord.log"
depend() { need net; after hivepilot-api; }
