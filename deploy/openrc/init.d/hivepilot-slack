#!/sbin/openrc-run
description="HivePilot Slack bot (Socket Mode -- outbound only, no public endpoint)"
command="/opt/hivepilot/venv/bin/hivepilot"
command_args="slack start --mode socket"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/hivepilot-slack.log"
error_log="/var/log/hivepilot-slack.log"
depend() { need net; after hivepilot-api; }
