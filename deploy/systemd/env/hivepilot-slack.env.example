# Copy to /etc/hivepilot/hivepilot-slack.env and fill in the placeholders.
#
# See deploy/systemd/env/shared.env.example for vars every hivepilot-*
# service must share (e.g. IS_SANDBOX) -- those go there, not here.
#
# hivepilot-slack.service sets WorkingDirectory=/ -- keep every path-shaped
# value below absolute.
#
# Socket Mode (this service's default -- outbound-only, no public HTTPS
# endpoint needed) requires ALL THREE of the values below: the bot token AND
# the signing secret (both mandatory for every mode -- the slack-bolt App is
# constructed with both regardless of transport) AND the app-level token
# (xapp-..., Socket Mode only). See deploy/systemd/README.md.
#
# FORMAT WARNING: plain KEY=value only -- no `export `, no $VAR expansion
# (systemd EnvironmentFile does not run a shell). See deploy/systemd/README.md.

HIVEPILOT_BASE_DIR=/data
HIVEPILOT_SLACK_BOT_TOKEN=<PASTE_YOUR_XOXB_BOT_TOKEN_HERE>
HIVEPILOT_SLACK_SIGNING_SECRET=<paste-your-signing-secret-here>
HIVEPILOT_SLACK_APP_TOKEN=<PASTE_YOUR_XAPP_APP_TOKEN_HERE>

# Optional: restrict which channels the bot will respond in / notify (JSON
# array of channel IDs) -- open to all channels when unset.
# HIVEPILOT_SLACK_ALLOWED_CHANNEL_IDS=["C0123456789"]
# HIVEPILOT_SLACK_NOTIFICATION_CHANNEL_ID=C0123456789
