# Copy to /etc/hivepilot/hivepilot-telegram.env and fill in the placeholders.
#
# See deploy/systemd/env/shared.env.example for vars every hivepilot-*
# service must share (e.g. IS_SANDBOX) -- those go there, not here.
#
# hivepilot-telegram.service sets WorkingDirectory=/ -- keep every
# path-shaped value below absolute.
#
# FORMAT WARNING: plain KEY=value only -- no `export `, no $VAR expansion
# (systemd EnvironmentFile does not run a shell). See deploy/systemd/README.md.

HIVEPILOT_BASE_DIR=/data
HIVEPILOT_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# Optional per-door tokens (Inbox / Approvals / Runs / Alerts). Unset
# doors use HIVEPILOT_TELEGRAM_BOT_TOKEN above. systemd EnvironmentFile
# is plain KEY=value — one var per door, not a JSON map.
# When 2+ of these are distinct tokens, telegram start (polling) runs
# one Application per unique token (HP-130b) and routes Inbox/Approvals/
# Runs/Alerts by door bot without forum message_thread_id (HP-130c).
# One shared token keeps the current STREAM_TOPICS path.
# HIVEPILOT_TELEGRAM_BOT_TOKEN_INBOX=<inbox-bot-token>
# HIVEPILOT_TELEGRAM_BOT_TOKEN_APPROVALS=<approvals-bot-token>
# HIVEPILOT_TELEGRAM_BOT_TOKEN_RUNS=<runs-bot-token>
# HIVEPILOT_TELEGRAM_BOT_TOKEN_ALERTS=<alerts-bot-token>
# HIVEPILOT_TELEGRAM_ALLOWED_CHAT_IDS=[111111111,222222222]
# HIVEPILOT_TELEGRAM_NOTIFICATION_CHAT_ID=111111111
