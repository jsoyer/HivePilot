# Copy to /etc/hivepilot/hivepilot-api.env and fill in the placeholders.
#
# See deploy/systemd/env/shared.env.example for vars every hivepilot-*
# service must share (e.g. IS_SANDBOX) -- those go there, not here.
#
# hivepilot-api.service sets WorkingDirectory=/ -- a relative path here
# resolves against `/`, not against this file's own directory or any
# checkout. Every path-shaped value below MUST be absolute.
#
# FORMAT WARNING: plain KEY=value only -- no `export `, no $VAR expansion
# (systemd EnvironmentFile does not run a shell). See deploy/systemd/README.md.

HIVEPILOT_BASE_DIR=/data
HIVEPILOT_API_HOST=127.0.0.1
HIVEPILOT_API_PORT=8045
HIVEPILOT_CONFIG_REPO=<your-config-repo-url>
# HIVEPILOT_CONFIG_TOKEN=<github-pat>   # only for https:// config repo URLs (see docs/DEPLOY-PRODUCTION.md#3-wire-the-config)

# HIVEPILOT_API_TOKEN is NOT required for `api serve` to start (unlike
# hivepilot-scheduler.env.example below) -- only set it here if some other
# admin-role CLI command you run against this host needs one.
# HIVEPILOT_API_TOKEN=<admin-or-run-role-token>
