# Copy to /etc/hivepilot/hivepilot-discord.env and fill in the placeholders.
#
# See deploy/systemd/env/shared.env.example for vars every hivepilot-*
# service must share (e.g. IS_SANDBOX) -- those go there, not here.
#
# hivepilot-discord.service sets WorkingDirectory=/ -- keep every
# path-shaped value below absolute.
#
# Gateway mode (this service's default -- outbound-only WebSocket, no public
# HTTPS endpoint needed) only needs the bot token below.
#
# FORMAT WARNING: plain KEY=value only -- no `export `, no $VAR expansion
# (systemd EnvironmentFile does not run a shell). See deploy/systemd/README.md.

HIVEPILOT_BASE_DIR=/data
HIVEPILOT_DISCORD_BOT_TOKEN=<your-bot-token>

# HIVEPILOT_DISCORD_PUBLIC_KEY is ONLY used by webhook (HTTP interactions)
# mode's Ed25519 signature verification -- leave it unset for gateway mode.
# HIVEPILOT_DISCORD_PUBLIC_KEY=<ed25519-public-key-hex>

# Optional: restrict which guilds/channels the bot will respond in / notify
# (JSON arrays of numeric snowflake IDs) -- open to all when unset.
# HIVEPILOT_DISCORD_ALLOWED_GUILD_IDS=[123456789012345678]
# HIVEPILOT_DISCORD_ALLOWED_CHANNEL_IDS=[123456789012345678]
# HIVEPILOT_DISCORD_NOTIFICATION_CHANNEL_ID=123456789012345678
