# Copy to /etc/hivepilot/hivepilot-scheduler.env and fill in the placeholders.
#
# See deploy/systemd/env/shared.env.example for vars every hivepilot-*
# service must share (e.g. IS_SANDBOX) -- those go there, not here.
#
# hivepilot-scheduler.service sets WorkingDirectory=/ -- keep every
# path-shaped value below absolute.
#
# FORMAT WARNING: plain KEY=value only -- no `export `, no $VAR expansion
# (systemd EnvironmentFile does not run a shell). See deploy/systemd/README.md.

HIVEPILOT_BASE_DIR=/data
HIVEPILOT_CONFIG_REPO=<your-config-repo-url>

# The scheduler daemon is fail-closed -- it refuses to start without a
# run-role token. Bootstrap one first (docs/DEPLOY-PRODUCTION.md#7-api-tokens-bootstrap).
HIVEPILOT_API_TOKEN=<run-role-token>
